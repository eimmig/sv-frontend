# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.iml

# Segredos — nunca versionados (ver docs/OBSERVABILITY-AND-CONFIG.md no vault)
.env
.env.local

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# Playwright (feat-001.7)
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Impeccable (feat-001.8) - platform-specific compiled binary, regenerated by
# `npx impeccable install`/`update`, not source (SKILL.md, reference docs, agents and the
# shared hook manifest at .claude/settings.json ARE committed - moved there from the
# gitignored-by-convention settings.local.json so every session on this repo gets the hook,
# not just the machine that ran the install).
.claude/skills/impeccable/scripts/bin/
.claude/settings.local.json

# huashu-design (feat-001.8) - optional bonus bgm/sfx assets for its video/animation-demo
# capability (~28MB of the skill's ~33MB), regenerated by `npx skills add
# https://github.com/alchaincyf/huashu-design` if that capability is ever actually used.
# Not this app's use case (prototyping, not marketing video) - SKILL.md/scripts/jsx templates
# ARE committed, only the audio bulk is excluded.
.agents/skills/huashu-design/assets/*.mp3
.agents/skills/huashu-design/assets/sfx/
.claude/skills/huashu-design/assets/*.mp3
.claude/skills/huashu-design/assets/sfx/

# System files
.DS_Store
Thumbs.db
